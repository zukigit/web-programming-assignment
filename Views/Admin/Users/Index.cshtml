@model List<User>

@{
    ViewData["Title"] = "Users";
}

<div class="crud-page">
    <div class="crud-header">
        <h1>User Management</h1>
        <a asp-action="Create" class="btn btn-sm btn-primary">+ New User</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Created</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.Username</td>
                        <td>@user.FullName</td>
                        <td>
                            <span class="badge badge-@user.Role.ToString().ToLower()">@user.Role</span>
                        </td>
                        <td>@user.Email</td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="col-actions">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-edit">Edit</a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-delete"
                                        onclick="return confirm('Delete user @user.Username?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="crud-footer">
        <a asp-action="Dashboard" class="btn btn-outline">&larr; Back to Dashboard</a>
    </div>
</div>
