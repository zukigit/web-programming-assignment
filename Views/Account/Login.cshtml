@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <div class="login-card">
        <h1>SchoolSystem</h1>
        <h2>Sign In</h2>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" />
                <span asp-validation-for="Username" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </form>

        <div class="login-hint">
            <p><strong>Sample accounts:</strong></p>
            <table>
                <tr><td>Admin</td><td>admin / admin123</td></tr>
                <tr><td>Teacher</td><td>teacher1 / teacher123</td></tr>
                <tr><td>Student</td><td>student1 / student123</td></tr>
            </table>
        </div>
    </div>
</div>
